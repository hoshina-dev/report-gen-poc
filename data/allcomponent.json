{
  "id": "all-inputs",
  "title": "All Input Types Showcase",
  "description": "Exercises every question type the form engine supports.",
  "userForm": {
    "title": "About you",
    "description": "Fill in every kind of input.",
    "questions": [
      {
        "id": "full_name",
        "type": "string",
        "label": "Full name",
        "description": "Short answer text.",
        "required": true,
        "placeholder": "e.g. Hoshina Suzuki",
        "maxLength": 80
      },
      {
        "id": "bio",
        "type": "textarea",
        "label": "Short bio",
        "description": "Paragraph text. Tell us about yourself.",
        "placeholder": "I'm a ...",
        "minRows": 3,
        "maxRows": 8,
        "maxLength": 500
      },
      {
        "id": "secret_code",
        "type": "password",
        "label": "Invite code",
        "description": "Hidden input. We won't show it back.",
        "placeholder": "•••••••",
        "minLength": 4
      },
      {
        "id": "age",
        "type": "number",
        "label": "Age",
        "min": 0,
        "max": 120,
        "step": 1,
        "default": 25
      },
      {
        "id": "country",
        "type": "select-string",
        "label": "Country",
        "description": "Single-value dropdown with text values.",
        "required": true,
        "placeholder": "Pick one",
        "options": [
          {
            "label": "Japan",
            "value": "JP"
          },
          {
            "label": "Thailand",
            "value": "TH"
          },
          {
            "label": "United States",
            "value": "US"
          },
          {
            "label": "Germany",
            "value": "DE"
          }
        ],
        "default": "JP"
      },
      {
        "id": "tshirt_size",
        "type": "select-number",
        "label": "T-shirt size (chest cm)",
        "description": "Single-value dropdown with number values.",
        "options": [
          {
            "label": "S (90cm)",
            "value": 90
          },
          {
            "label": "M (100cm)",
            "value": 100
          },
          {
            "label": "L (110cm)",
            "value": 110
          },
          {
            "label": "XL (120cm)",
            "value": 120
          }
        ],
        "default": 100
      },
      {
        "id": "languages",
        "type": "multi-select",
        "label": "Languages you speak",
        "description": "Multi-select dropdown.",
        "placeholder": "Pick any",
        "maxValues": 5,
        "options": [
          {
            "label": "English",
            "value": "en"
          },
          {
            "label": "Japanese",
            "value": "ja"
          },
          {
            "label": "Thai",
            "value": "th"
          },
          {
            "label": "German",
            "value": "de"
          },
          {
            "label": "French",
            "value": "fr"
          },
          {
            "label": "Spanish",
            "value": "es"
          }
        ],
        "default": [
          "en"
        ]
      },
      {
        "id": "contact_pref",
        "type": "radio",
        "label": "Preferred contact",
        "description": "Single choice via radio buttons.",
        "required": true,
        "options": [
          {
            "label": "Email",
            "value": "email"
          },
          {
            "label": "Phone",
            "value": "phone"
          },
          {
            "label": "Carrier pigeon",
            "value": "pigeon"
          }
        ],
        "default": "email"
      },
      {
        "id": "interests",
        "type": "checkbox-group",
        "label": "Interests",
        "description": "Multi-select via checkboxes.",
        "options": [
          {
            "label": "Coffee",
            "value": "coffee"
          },
          {
            "label": "Cooking",
            "value": "cooking"
          },
          {
            "label": "Cycling",
            "value": "cycling"
          },
          {
            "label": "Reading",
            "value": "reading"
          },
          {
            "label": "Gaming",
            "value": "gaming"
          }
        ],
        "default": [
          "coffee",
          "reading"
        ]
      },
      {
        "id": "newsletter",
        "type": "boolean",
        "label": "Subscribe to newsletter",
        "description": "Yes/No switch.",
        "default": true
      },
      {
        "id": "plan",
        "type": "segmented",
        "label": "Plan",
        "description": "Segmented control.",
        "options": [
          {
            "label": "Free",
            "value": "free"
          },
          {
            "label": "Pro",
            "value": "pro"
          },
          {
            "label": "Team",
            "value": "team"
          }
        ],
        "default": "pro"
      },
      {
        "id": "satisfaction",
        "type": "slider",
        "label": "Overall satisfaction",
        "description": "Linear scale (slider).",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 7,
        "marks": [
          {
            "value": 0,
            "label": "0"
          },
          {
            "value": 5,
            "label": "5"
          },
          {
            "value": 10,
            "label": "10"
          }
        ]
      },
      {
        "id": "quality",
        "type": "rating",
        "label": "Rate the product",
        "description": "Star rating, half-stars allowed.",
        "count": 5,
        "fractions": 2,
        "default": 4
      },
      {
        "id": "fav_color",
        "type": "color",
        "label": "Favourite color",
        "description": "Color picker (hex).",
        "default": "#7048e8",
        "swatches": [
          "#fa5252",
          "#fd7e14",
          "#fab005",
          "#40c057",
          "#228be6",
          "#7048e8",
          "#000000",
          "#ffffff"
        ]
      },
      {
        "id": "birthday",
        "type": "date",
        "label": "Birthday",
        "description": "Date picker.",
        "min": "1900-01-01",
        "max": "2025-12-31"
      },
      {
        "id": "wake_time",
        "type": "time",
        "label": "Usual wake time",
        "description": "Time picker.",
        "default": "07:30"
      },
      {
        "id": "event_at",
        "type": "datetime",
        "label": "Event start",
        "description": "Date + time.",
        "default": "2026-06-01T19:00"
      },
      {
        "id": "skills",
        "type": "tags",
        "label": "Skills",
        "description": "Free-form tags (press Enter to add).",
        "placeholder": "Type and press Enter",
        "maxTags": 8,
        "default": [
          "typescript",
          "react"
        ]
      }
    ]
  },
  "workerForm": {
    "title": "Reviewer notes",
    "description": "Confirm a couple of fields and add a verdict.",
    "questions": [
      {
        "id": "full_name",
        "type": "string",
        "label": "Submitted by",
        "prefillFrom": "full_name"
      },
      {
        "id": "plan",
        "type": "segmented",
        "label": "Plan (from user)",
        "options": [
          {
            "label": "Free",
            "value": "free"
          },
          {
            "label": "Pro",
            "value": "pro"
          },
          {
            "label": "Team",
            "value": "team"
          }
        ],
        "prefillFrom": "plan"
      },
      {
        "id": "quality",
        "type": "rating",
        "label": "User's rating",
        "count": 5,
        "fractions": 2,
        "prefillFrom": "quality"
      },
      {
        "id": "verdict",
        "type": "radio",
        "label": "Reviewer verdict",
        "required": true,
        "options": [
          {
            "label": "Approve",
            "value": "approve"
          },
          {
            "label": "Reject",
            "value": "reject"
          },
          {
            "label": "Needs follow-up",
            "value": "followup"
          }
        ],
        "default": "approve"
      },
      {
        "id": "reviewer_notes",
        "type": "textarea",
        "label": "Notes",
        "placeholder": "Anything to flag?",
        "minRows": 2,
        "maxRows": 6
      },
      {
        "id": "reviewed_at",
        "type": "datetime",
        "label": "Reviewed at",
        "required": true
      }
    ]
  },
  "calculations": {
    "interestCount": "Array.isArray(interests) ? interests.length : 0",
    "languageCount": "Array.isArray(languages) ? languages.length : 0",
    "approved": "verdict === 'approve'",
    "scoreOutOfTen": "(Number(quality) || 0) * 2"
  },
  "template": "{{full_name}} ({{country}}, plan: {{plan}}) — verdict: {{verdict}}. Satisfaction {{satisfaction}}/10, quality {{quality}}/5 ({{scoreOutOfTen}}/10). Speaks {{languageCount}} language(s), has {{interestCount}} interest(s). Approved: {{approved}}.",
  "components": [
    {
      "id": "text_1779704579771",
      "type": "text",
      "content": "{{template}}",
      "rect": [
        35,
        250,
        512,
        60
      ],
      "style": {
        "font": "Helvetica",
        "size": 12,
        "bold": false,
        "italic": false,
        "align": "left"
      }
    },
    {
      "id": "text_1779704632503",
      "type": "text",
      "content": "Report",
      "rect": [
        239,
        661,
        150,
        60
      ],
      "style": {
        "font": "Helvetica",
        "size": 30,
        "bold": true,
        "italic": false,
        "align": "center"
      }
    },
    {
      "id": "shape_1779705187431",
      "type": "shape",
      "shape_type": "rect",
      "rect": [
        0,
        732,
        500,
        60
      ],
      "color": "#6600ff",
      "stroke_width": 1,
      "fill": true
    }
  ]
}