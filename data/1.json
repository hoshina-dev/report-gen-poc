        "id": "sample_mass",
        "type": "string",
        "label": "Sample mass (g)",
        "required": true,
        "default": "1.2340"
      },
      {
        "id": "temperature_initial",
        "type": "string",
        "label": "Initial temperature (°C)",
        "required": true,
        "default": "24.82"
      },
      {
        "id": "temperature_final",
        "type": "string",
        "label": "Final temperature (°C)",
        "required": true,
        "default": "30.17"
      },
      {
        "id": "calorimeter_constant",
        "type": "string",
        "label": "Calorimeter constant (J/°C)",
        "required": true,
        "default": "9845.0"
      }
