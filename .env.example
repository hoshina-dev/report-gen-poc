# ─── Both ─────────────────────────────────────────────────────────────────
DATA_JSON=

# ─── PDF Gen ──────────────────────────────────────────────────────────────
COMPONENTS_JSON=
PDF_OUTPUT=generated/output.pdf   # local dev only; ignored when S3_BUCKET is set

# ─── R2 storage ──────────────────────────────────────────────
# Leave blank for local dev — PDF will be written to PDF_OUTPUT instead
S3_BUCKET=
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ─── Webhook ─────────────────────────────────────────────────
# Full endpoint URL; {exp_id} is substituted at runtime. Leave blank to skip webhook (local dev).
WEBHOOK_URL=https://api.example.com/api/experiments/{exp_id}/report

# ─── Editor ───────────────────────────────────────────────────────────────
EDITOR_HOST=127.0.0.1
EDITOR_PORT=8765
DATA_SOURCE_NAME="host=localhost user=postgres password=postgres dbname=expriment        
